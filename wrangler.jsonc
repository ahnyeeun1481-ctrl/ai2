{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahnyeeun-portfolio",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://ahnyeeun-portfolio.ahnyeeun1481.workers.dev",
    "ADDITIONAL_ALLOWED_ORIGINS": "https://ahnyeeun1481-ctrl.github.io",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF5wi9Nzsemm3eZQ"
  },
  "assets": {
    "directory": "cloudflare-site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-comments",
      "database_id": "0548b30b-79ae-4021-b588-dc5864e0cb1e",
      "migrations_dir": "worker/migrations"
    }
  ]
}